# OpenSSL 3.x: ativa o provider "legacy" para suportar algoritmos antigos
# usados em alguns certificados .pfx (ex.: certificados A1 brasileiros).
# Necessário para evitar: error:0308010C:digital envelope routines::unsupported
#
# Uso: defina OPENSSL_CONF=/app/openssl-legacy.cnf no ambiente do container/processo.

openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect
legacy = legacy_sect

[default_sect]
activate = 1

[legacy_sect]
activate = 1
